# ─── Configuração de Autenticação ──────────────────────────
ADMIN_USERNAME=SA
# Gerar um hash bcrypt para uma password forte e privada; nunca usar exemplos.
ADMIN_PASSWORD_HASH=
# Gerar um segredo aleatório com pelo menos 32 bytes.
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
# Chave Fernet privada para cifrar credenciais guardadas.
SETTINGS_ENCRYPTION_KEY=
# Diretório privado e persistente, fora de public_html e frontend/dist.
# Se vazio/omitido, mantém os caminhos locais existentes.
# ICMAV_DATA_DIR=/caminho/privado/icmav-data

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A chave MB WAY é gerida no backoffice e cifrada com SETTINGS_ENCRYPTION_KEY.
